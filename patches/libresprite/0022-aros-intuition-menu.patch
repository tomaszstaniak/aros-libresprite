+// LibreSprite | Copyright (C) 2026  LibreSprite contributors
+//
+// This file is released under the terms of the MIT license.
+// Read LICENSE.txt for more information.
+
+#pragma once
+
+// AROS: the application's commands in the window's Intuition menu.
+// The SDL3 back end passes the two Intuition events the application needs;
+// building the menu strip (GadTools) is up to the application.
+
+#include <functional>
+
+namespace she {
+namespace aros {
+
+  // verify(window): just before the menu shows (IDCMP_MENUVERIFY); the
+  // application may change item flags, but must not replace the strip.
+  // pick(MENUNULL): the menu closed without a choice.
+  // pick(menuNumber): an item of the application's strip was chosen
+  // (Intuition menu number, one call per selected item).
+  void setMenuHandlers(std::function<void(void* intuitionWindow)> verify,
+                       std::function<void(int menuNumber)> pick);
+
+  // The Intuition window (struct Window *) of the main display, or nullptr.
+  void* mainWindow();
+
