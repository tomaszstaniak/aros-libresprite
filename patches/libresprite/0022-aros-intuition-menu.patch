+++ b/src/app/ui/aros_menu_strip.cpp
@@ -0,0 +1,418 @@
+// LibreSprite | Copyright (C) 2026  LibreSprite contributors
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License version 2 as
+// published by the Free Software Foundation.
+
+// AROS: the main menu as the window's Intuition menu (GadTools), built from
+// the same menus as the in-window menu bar (gui.xml "main_menu").
+//
+// - Just before Intuition shows the menu (IDCMP_MENUVERIFY) the enabled and
+//   checked flags of the items are updated in place. Every item reserves the
+//   check mark column, so a check mark can appear on any opening.
+// - The strip is rebuilt when the menu structure changes (recent files,
+//   scripts, shortcuts): at once when the menu is not in use, otherwise after
+//   it closes. A pick that belongs to a menu shown before a rebuild is ignored.
+// - Commands run only while the main window is in the foreground, as with
+//   keyboard shortcuts: a modal dialog blocks them.
+// - Commands with a Ctrl+letter shortcut also get Amiga+letter.
+
+#ifdef __AROS__
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "app/ui/aros_menu_strip.h"
+
+#include "app/app.h"
+#include "app/app_menus.h"
+#include "app/commands/command.h"
+#include "app/commands/params.h"
+#include "app/task_manager.h"
+#include "app/ui/app_menuitem.h"
+#include "app/ui/keyboard_shortcuts.h"
+#include "app/ui/main_window.h"
+#include "app/ui_context.h"
+#include "she/aros_menu.h"
+#include "ui/manager.h"
+#include "ui/menu.h"
+#include "ui/window.h"
+
+#include <intuition/intuition.h>
+#include <libraries/gadtools.h>
+#include <proto/exec.h>
+#include <proto/gadtools.h>
+#include <proto/intuition.h>
+
+#include <deque>
+#include <string>
+#include <vector>
+
+namespace app {
+
+namespace {
+
+  // One built strip and everything its NewMenu entries point to.
+  struct Strip {
+    ::Menu* menu = nullptr;
+    APTR visualInfo = nullptr;
+    std::deque<std::string> texts;    // labels and command keys (stable addresses)
+    struct Picked {
+      Command* command;
+      Params params;
+      ::MenuItem* item;               // filled in after CreateMenus
+    };
+    std::vector<Picked> items;        // NewMenu user data: index + 1
+    std::string signature;            // structure, see structure()
+    unsigned generation = 0;
+  };
+
+  Strip* current = nullptr;
+  unsigned generation = 0;      // of the last built strip
+  unsigned sessionStrip = 0;    // strip generation shown by the open menu, 0: none
+  bool menuOpen = false;        // between IDCMP_MENUVERIFY and the closing pick
+  bool rebuildPending = false;  // structure changed while the menu was in use
+  bool rebuildQueued = false;
+
+  // Same rule as keyboard shortcuts (app/modules/gui.cpp): commands run only
+  // when the main window is the window in the foreground.
+  bool mainWindowInForeground()
+  {
+    ui::Manager* manager = ui::Manager::getDefault();
+    if (!manager || !App::instance())
+      return false;
+    for (ui::Widget* widget : manager->children()) {
+      auto* window = static_cast<ui::Window*>(widget);
+      if (window->isForeground())
+        return false;
+      if (window->isDesktop() && window == App::instance()->mainWindow())
+        return true;
+    }
+    return false;
+  }
+
+  // GTMENUITEM_USERDATA(item), spelled out: the macro names "struct MenuItem",
+  // which is ambiguous inside namespace app.
+  IPTR userData(::MenuItem* item)
+  {
+    return (IPTR)*reinterpret_cast<APTR*>(item + 1);
+  }
+
+  // Menu text: drop the '&' mnemonic markers; GadTools draws bytes of the
+  // system character set, so keep plain ASCII.
+  std::string label(const std::string& text)
+  {
+    std::string out;
+    for (size_t i = 0; i < text.size(); ++i) {
+      unsigned char c = text[i];
+      if (c == '&') {
+        if (i + 1 < text.size() && text[i + 1] == '&')
+          out += '&', ++i;
+        continue;
+      }
+      if (c >= 0x80) {
+        // skip the rest of a UTF-8 sequence
+        while (i + 1 < text.size() && (static_cast<unsigned char>(text[i + 1]) & 0xC0) == 0x80)
+          ++i;
+        out += '?';
+        continue;
+      }
+      out += static_cast<char>(c);
+    }
+    return out;
+  }
+
+  // Amiga+letter for a command whose shortcut is Ctrl+letter.
+  char amigaKey(AppMenuItem* item)
+  {
+    Key* key = item->key();
+    if (!key)
+      return 0;
+    for (const ui::Accelerator& accel : key->accels()) {
+      if (accel.modifiers() == she::kKeyCtrlModifier &&
+          accel.scancode() >= she::kKeyA && accel.scancode() <= she::kKeyZ)
+        return 'A' + (accel.scancode() - she::kKeyA);
+    }
+    return 0;
+  }
+
+  // Menu structure only (labels, commands, Amiga keys); states are applied
+  // by applyState().
+  void addEntries(Strip& strip, std::vector<struct NewMenu>& out, ui::Menu* menu,
+                  UBYTE type)
+  {
+    for (ui::Widget* child : menu->children()) {
+      if (dynamic_cast<ui::MenuSeparator*>(child)) {
+        if (!out.empty() && out.back().nm_Label != NM_BARLABEL && out.back().nm_Type != NM_TITLE)
+          out.push_back({ type, NM_BARLABEL, nullptr, 0, 0, nullptr });
+        continue;
+      }
+      auto* menuItem = dynamic_cast<ui::MenuItem*>(child);
+      if (!menuItem)
+        continue;
+
+      strip.texts.push_back(label(menuItem->text()));
+      // CHECKIT on every item: the check mark column is always there, so any
+      // command can show its state without a new strip.
+      struct NewMenu nm = { type, (STRPTR)strip.texts.back().c_str(), nullptr, CHECKIT, 0, nullptr };
+
+      if (auto* appItem = dynamic_cast<AppMenuItem*>(menuItem)) {
+        if (Command* command = appItem->getCommand()) {
+          Params params = appItem->getParams();
+          if (char k = amigaKey(appItem)) {
+            strip.texts.push_back(std::string(1, k));
+            nm.nm_CommKey = (STRPTR)strip.texts.back().c_str();
+          }
+          strip.items.push_back({ command, params, nullptr });
+          nm.nm_UserData = (APTR)(IPTR)strip.items.size();
+        }
+      }
+
+      ui::Menu* submenu = menuItem->getSubmenu();
+      if (submenu && type == NM_ITEM) {
+        nm.nm_Flags &= ~CHECKIT;   // the submenu arrow takes that place
+        out.push_back(nm);
+        addEntries(strip, out, submenu, NM_SUB);
+      }
+      else if (submenu) {
+        // Intuition has two levels below the title: deeper menus are left out.
+        continue;
+      }
+      else {
+        out.push_back(nm);
+      }
+    }
+    if (!out.empty() && out.back().nm_Label == NM_BARLABEL)
+      out.pop_back();
+  }
+
+  // The NewMenu entries of the current app menus; returns false without menus.
+  bool structure(Strip& strip, std::vector<struct NewMenu>& entries)
+  {
+    ui::Menu* root = AppMenus::instance()->getRootMenu();
+    if (!root)
+      return false;
+    for (ui::Widget* child : root->children()) {
+      auto* title = dynamic_cast<ui::MenuItem*>(child);
+      if (!title || !title->getSubmenu())
+        continue;
+      strip.texts.push_back(label(title->text()));
+      entries.push_back({ NM_TITLE, (STRPTR)strip.texts.back().c_str(), nullptr, 0, 0, nullptr });
+      addEntries(strip, entries, title->getSubmenu(), NM_ITEM);
+    }
+    entries.push_back({ NM_END, nullptr, nullptr, 0, 0, nullptr });
+
+    std::string& sig = strip.signature;
+    for (const struct NewMenu& nm : entries) {
+      sig += char('0' + nm.nm_Type);
+      if (nm.nm_Label == NM_BARLABEL)
+        sig += '-';
+      else if (nm.nm_Label)
+        sig += (const char*)nm.nm_Label;
+      sig += '\1';
+      if (nm.nm_CommKey)
+        sig += (const char*)nm.nm_CommKey;
+      sig += '\2';
+    }
+    return true;
+  }
+
+  // Enabled and checked flags from the commands; with the main window not
+  // in the foreground every command item is disabled.
+  void applyState(Strip& strip)
+  {
+    Context* context = UIContext::instance();
+    context->updateFlags();
+    bool foreground = mainWindowInForeground();
+    for (Strip::Picked& entry : strip.items) {
+      if (!entry.item)
+        continue;
+      Params params = entry.params;
+      entry.command->loadParams(params);
+      if (foreground && entry.command->isEnabled(context))
+        entry.item->Flags |= ITEMENABLED;
+      else
+        entry.item->Flags &= ~ITEMENABLED;
+      if (entry.command->isChecked(context))
+        entry.item->Flags |= CHECKED;
+      else
+        entry.item->Flags &= ~CHECKED;
+    }
+  }
+
+  Strip* build(::Window* window)
+  {
+    if (!window)
+      return nullptr;
+    auto* strip = new Strip;
+    std::vector<struct NewMenu> entries;
+    if (!structure(*strip, entries)) {
+      delete strip;
+      return nullptr;
+    }
+
+    strip->visualInfo = GetVisualInfoA(window->WScreen, nullptr);
+    strip->menu = strip->visualInfo ? CreateMenusA(entries.data(), nullptr) : nullptr;
+    struct TagItem layoutTags[] = { { GTMN_NewLookMenus, TRUE }, { TAG_DONE, 0 } };
+    if (!strip->menu || !LayoutMenusA(strip->menu, strip->visualInfo, layoutTags)) {
+      if (strip->menu)
+        FreeMenus(strip->menu);
+      if (strip->visualInfo)
+        FreeVisualInfo(strip->visualInfo);
+      delete strip;
+      return nullptr;
+    }
+    // Remember each command item, for the flag updates.
+    for (::Menu* m = strip->menu; m; m = m->NextMenu)
+      for (::MenuItem* i = m->FirstItem; i; i = i->NextItem) {
+        for (::MenuItem* s = i; s; s = (s == i ? i->SubItem : s->NextItem)) {
+          IPTR index = userData(s);
+          if (index > 0 && index <= strip->items.size())
+            strip->items[index - 1].item = s;
+        }
+      }
+    strip->generation = ++generation;
+    applyState(*strip);
+    return strip;
+  }
+
+  void dispose(Strip* strip)
+  {
+    if (!strip)
+      return;
+    FreeMenus(strip->menu);
+    FreeVisualInfo(strip->visualInfo);
+    delete strip;
+  }
+
+  // Replaces the window's strip with a freshly built one. Not while the
+  // menu is in use.
+  void rebuild(void* intuitionWindow)
+  {
+    auto* window = static_cast<::Window*>(intuitionWindow);
+    if (!window)
+      return;
+    Strip* fresh = build(window);
+    if (!fresh)
+      return;
+    if (current)
+      ClearMenuStrip(window);
+    if (!SetMenuStrip(window, fresh->menu)) {
+      if (current)
+        ResetMenuStrip(window, current->menu);
+      dispose(fresh);
+      return;
+    }
+    dispose(current);
+    current = fresh;
+  }
+
+  // IDCMP_MENUVERIFY: Intuition waits for this; only item flags change here.
+  void verify(void*)
+  {
+    if (!current)
+      return;
+    menuOpen = true;
+    sessionStrip = current->generation;
+    applyState(*current);
+    if (!rebuildPending) {
+      // A structure change that did not report itself: the next strip.
+      Strip probe;
+      std::vector<struct NewMenu> entries;
+      if (structure(probe, entries) && probe.signature != current->signature)
+        rebuildPending = true;
+    }
+  }
+
+  // Rebuilds the strip from the UI loop, unless a menu is in use then (the
+  // pick that closes it calls this again).
+  void scheduleRebuild()
+  {
+    if (menuOpen) {
+      rebuildPending = true;
+      return;
+    }
+    rebuildPending = false;
+    if (rebuildQueued)
+      return;
+    rebuildQueued = true;
+    TaskManager::instance().delayed([]{
+      rebuildQueued = false;
+      if (menuOpen) {
+        rebuildPending = true;
+        return;
+      }
+      if (void* window = she::aros::mainWindow())
+        rebuild(window);
+    });
+  }
+
+  void pick(int menuNumber)
+  {
+    if (!current)
+      return;
+    // A menu shown before a rebuild has other item numbers.
+    bool stale = (sessionStrip != 0 && sessionStrip != current->generation);
+    bool fromMenu = menuOpen;
+    menuOpen = false;
+    sessionStrip = 0;
+    if (fromMenu && rebuildPending)
+      scheduleRebuild();
+    if ((UWORD)menuNumber == MENUNULL || stale)
+      return;
+
+    ::MenuItem* item = ItemAddress(current->menu, (UWORD)menuNumber);
+    if (!item)
+      return;
+    IPTR index = userData(item);
+    if (index == 0 || index > current->items.size())
+      return;
+    // Copy: the strip may be rebuilt before this runs.
+    Strip::Picked picked = current->items[index - 1];
+    // Run it from the UI loop, not from inside SDL's event pump. Amiga+key
+    // picks arrive without IDCMP_MENUVERIFY, so everything is checked here.
+    TaskManager::instance().delayed([picked]{
+      if (!mainWindowInForeground())
+        return;
+      Params params = picked.params;
+      picked.command->loadParams(params);
+      UIContext* context = UIContext::instance();
+      context->updateFlags();
+      if (picked.command->isEnabled(context))
+        context->executeCommand(picked.command, params);
+    });
+  }
+
+} // anonymous namespace
+
+bool install_aros_menu_strip()
+{
+  void* window = she::aros::mainWindow();
+  if (!window)
+    return false;
+  she::aros::setMenuHandlers(verify, pick);
+  rebuild(window);
+  return current != nullptr;
+}
+
+void aros_menu_strip_changed()
+{
+  if (current)
+    scheduleRebuild();
+}
+
+void uninstall_aros_menu_strip()
+{
+  she::aros::setMenuHandlers(nullptr, nullptr);
+  if (current) {
+    if (auto* window = static_cast<::Window*>(she::aros::mainWindow()))
+      ClearMenuStrip(window);
+    dispose(current);
+    current = nullptr;
+  }
+}
+
+} // namespace app
+
+#endif // __AROS__
