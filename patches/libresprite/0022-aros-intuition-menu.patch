+namespace she {
+namespace aros {
+
+  static std::function<void(void*)> menuVerify;
+  static std::function<void(int)> menuPick;
+
+  // Called by SDL from its event pump, before Intuition shows the menu.
+  static void menuVerifyTrampoline(void*, void* window)
+  {
+    if (menuVerify)
+      menuVerify(window);
+  }
+
+  // The application has one SDL window.
+  static SDL_Window* firstWindow()
+  {
+    int count = 0;
+    SDL_Window** windows = SDL_GetWindows(&count);
+    SDL_Window* window = (windows && count > 0) ? windows[0] : nullptr;
+    SDL_free(windows);
+    return window;
+  }
+
+  void setMenuHandlers(std::function<void(void*)> verify, std::function<void(int)> pick)
+  {
+    menuVerify = std::move(verify);
+    menuPick = std::move(pick);
+    // aros-sdl SDL3 window properties
+    if (SDL_Window* window = firstWindow()) {
+      SDL_PropertiesID props = SDL_GetWindowProperties(window);
+      SDL_SetPointerProperty(props, "SDL.window.aros.menuverify_callback",
+                             reinterpret_cast<void*>(&menuVerifyTrampoline));
+      SDL_SetPointerProperty(props, "SDL.window.aros.menuverify_userdata", nullptr);
+    }
+  }
+
+  void* mainWindow()
+  {
+    SDL_Window* window = firstWindow();
+    return window ? SDL_GetPointerProperty(SDL_GetWindowProperties(window), "SDL.window.aros.window", nullptr)
+                  : nullptr;
+  }
+
+  // An application menu pick, sent by SDL as its own event type.
+  static bool handleEvent(const SDL_Event& event)
+  {
+    SDL_Window* window = SDL_GetWindowFromID(event.user.windowID);
+    if (!window)
+      return false;
+    Uint32 type = (Uint32)SDL_GetNumberProperty(SDL_GetWindowProperties(window), "SDL.window.aros.menupick_event", 0);
+    if (type == 0 || event.type != type)
+      return false;
+    if (menuPick)
+      menuPick(event.user.code);
+    return true;
+  }
+
+} // namespace aros
