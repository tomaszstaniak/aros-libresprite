diff --git a/src/main/main.cpp b/src/main/main.cpp
index 80e28064578f2ec26c141913888a859bddba6dc1..29991147bc544552e4856f8a8d9b689ae56aa0a3 100644
--- a/src/main/main.cpp
+++ b/src/main/main.cpp
@@ -35,6 +35,49 @@
 // AROS startup code reads __stack and gives the main task at least this much
 // stack; a Shell's default (often 256 KiB) is far too small for the UI.
 extern "C" { unsigned long __stack = 8 * 1024 * 1024; }
+
+#include "base/system_path.h"
+
+#include <aros/startup.h>
+#include <proto/dos.h>
+#include <workbench/startup.h>
+
+#include <cstdio>
+#include <string>
+#include <vector>
+
+namespace {
+
+  // Started from Workbench, argc is 0 and argv is the WBStartup message:
+  // give the program a normal argument list with the paths of the icons
+  // it was started with (project icons whose default tool it is, or icons
+  // selected together with it).
+  void aros_workbench_arguments(int& argc, char**& argv)
+  {
+    static std::vector<std::string> args;
+    static std::vector<char*> ptrs;
+    if (argc != 0)
+      return;
+    // No Shell: console output would open a CON: window.
+    std::freopen("NIL:", "w", stdout);
+    std::freopen("NIL:", "w", stderr);
+    args.push_back("LibreSprite");
+    struct WBStartup* wb = WBenchMsg;
+    for (LONG i = 1; wb && i < wb->sm_NumArgs; ++i) {
+      const struct WBArg& arg = wb->sm_ArgList[i];
+      char path[1024];
+      if (arg.wa_Lock && NameFromLock(arg.wa_Lock, path, sizeof(path)) &&
+          AddPart(path, (CONST_STRPTR)arg.wa_Name, sizeof(path)))
+        args.push_back(base::from_system_path(path));
+    }
+    for (std::string& s : args)
+      ptrs.push_back(&s[0]);
+    ptrs.push_back(nullptr);
+    argc = int(args.size());
+    argv = ptrs.data();
+  }
+
+} // anonymous namespace
 #endif
 #ifdef EMSCRIPTEN
 #define LIFETIME static
