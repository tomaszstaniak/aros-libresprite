+#include "app/aros_gui_renderer.h"
+
+#include "base/fs.h"
+#include "base/log.h"
+#include "base/system_path.h"
+
+#include <proto/exec.h>
+#include <proto/icon.h>
+#include <workbench/workbench.h>
+
+#include <cctype>
+#include <string>
+
+namespace app {
+
+bool aros_gui_renderer(bool preference)
+{
+  std::string mode = "AUTO";
+  std::string program = base::to_system_path(base::get_app_path());
+  if (struct DiskObject* icon = GetDiskObject((CONST_STRPTR)program.c_str())) {
+    if (STRPTR value = (STRPTR)FindToolType(icon->do_ToolTypes, (STRPTR)"GUI_RENDERER"))
+      mode = value;
+    FreeDiskObject(icon);
+  }
+  for (char& c : mode)
+    c = char(std::toupper((unsigned char)c));
+
+  bool gl = false;
+  if (struct Library* glBase = OpenLibrary((CONST_STRPTR)"gl.library", 20)) {
+    gl = true;
+    CloseLibrary(glBase);
+  }
+
+  bool gpu;
+  if (mode == "CPU")
+    gpu = false;
+  else if (mode == "GPU")
+    gpu = true;
+  else
+    gpu = preference && gl;
+  LOG("GUI_RENDERER=%s, gl.library %s: %s\n", mode.c_str(),
+      gl ? "present" : "missing", gpu ? "OpenGL" : "CPU");
+  return gpu;
+}
+
+} // namespace app
+
+#endif // __AROS__
