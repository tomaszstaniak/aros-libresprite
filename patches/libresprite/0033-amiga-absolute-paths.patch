diff --git a/src/base/path.cpp b/src/base/path.cpp
index 271a050798324e0b75b696bfcdf11c59f0c5810f..3329c8a1639f2a09a271e93865b19ea919d1432c 100644
--- a/src/base/path.cpp
+++ b/src/base/path.cpp
@@ -11,6 +11,8 @@
 
 #include "base/path.h"
 
+#include <filesystem>
+
 #include "base/fs.h"            // TODO we should merge base/path.h and base/fs.h
 #include "base/string.h"
 
@@ -32,6 +34,16 @@ bool is_path_separator(std::string::value_type chr)
   return (chr == '\\' || chr == '/');
 }
 
+bool is_absolute_path(const std::string& path)
+{
+#ifdef __AROS__
+  auto colon = path.find(':');
+  if (colon != std::string::npos && colon < path.find('/'))
+    return true;
+#endif
+  return std::filesystem::path(path).is_absolute();
+}
+
 // Where the last path component starts. On AROS the colon after a volume or
 // assign name ("Work:", "RAM:") also ends a path component.
 static bool is_component_boundary(std::string::value_type chr)
