+#elif defined(__AROS__)
+/* AROS has no poll(): run the timers and sleep until the next one. Read and
+   write handlers on file descriptors (os.setReadHandler/os.setWriteHandler)
+   are not served; signals and workers are not built on AROS. */
+static int js_os_poll(JSContext *ctx)
+{
+    JSRuntime *rt = JS_GetRuntime(ctx);
+    JSThreadState *ts = js_get_thread_state(rt);
+    int min_delay;
+
+    if (js_os_run_timers(rt, ctx, ts, &min_delay))
+        return -1;
+    if (min_delay == 0)
+        return 0; // expired timer
+    if (min_delay < 0)
+        return -1; /* no more events */
+    usleep((useconds_t)min_delay * 1000);
+    return 0;
+}
 #else // !defined(_WIN32)
