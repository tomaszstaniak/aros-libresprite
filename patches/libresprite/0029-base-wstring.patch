+  if (!arg.empty() && arg.find_first_of(L" \t\n\"") == base::wstring::npos)
     return arg;
-  std::wstring out = L"\"";
+  base::wstring out = L"\"";
   for (size_t i = 0; i < arg.size(); ) {
     size_t backslashes = 0;
     while (i < arg.size() && arg[i] == L'\\') {
@@ -319,8 +319,8 @@ base::launcher::ProcessInfo spawnWin(const std::string& path,
