+#ifdef __AROS__
+#include <libraries/openurl.h>
+#include <proto/exec.h>
+#include <proto/openurl.h>
+#include <proto/workbench.h>
+
+namespace
+{
+
+// URLs go to the browser chosen in the OpenURL preferences.
+bool aros_open_url(const std::string& url)
+{
+  struct Library* OpenURLBase = OpenLibrary("openurl.library", 1);
+  if (!OpenURLBase)
+    return false;
+  struct TagItem tags[] = { { TAG_DONE, 0 } };
+  ULONG ok = URL_OpenA((STRPTR)url.c_str(), tags);
+  CloseLibrary(OpenURLBase);
+  return ok != 0;
+}
+
+// Files open with their default tool and drawers in a Workbench window,
+// as a double-click on their icons would.
+bool aros_open_object(const std::string& name)
+{
+  struct Library* WorkbenchBase = OpenLibrary("workbench.library", 44);
+  if (!WorkbenchBase)
+    return false;
+  BOOL ok = OpenWorkbenchObjectA((STRPTR)name.c_str(), NULL);
+  CloseLibrary(WorkbenchBase);
+  return ok != FALSE;
+}
+
+bool is_url(const std::string& s)
+{
+  auto colon = s.find("://");
+  return (colon != std::string::npos && colon > 1) || s.rfind("mailto:", 0) == 0;
+}
+
+} // namespace
+#endif
+
 namespace base {
 namespace launcher {
 
@@ -413,6 +455,10 @@ bool open_file(const std::string& file)
 
   ret = spawn_and_wait({"open", file});
 
+#elif defined(__AROS__)
+
+  ret = (is_url(file) ? aros_open_url(file) : aros_open_object(file)) ? 0 : -1;
+
 #elif ANDROID
 
   // No-op
@@ -454,6 +500,12 @@ bool open_folder(const std::string& _file)
   }
   return (ret == 0);
 
