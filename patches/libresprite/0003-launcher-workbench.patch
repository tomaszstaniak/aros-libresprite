+#if !defined(_WIN32) && !defined(__EMSCRIPTEN__) && !defined(ANDROID) && !defined(__AROS__)
 #include <signal.h>
 #include <spawn.h>
 #include <sys/wait.h>
@@ -197,7 +197,7 @@ std::optional<int> tryReapPosix(int pid, void*)
