+#include <cerrno>
 #include <stdexcept>
 
 #ifdef _WIN32
@@ -38,7 +39,12 @@ FILE* open_file_raw(const string& filename, const string& mode)
   return _wfopen(from_utf8(filename).c_str(),
                  from_utf8(mode).c_str());
 #else
-  return fopen(to_system_path(filename).c_str(), mode.c_str());
+  std::string sys;
+  if (!to_system_path(filename, sys)) {
+    errno = EILSEQ;   // not a name this system can store
+    return nullptr;
+  }
+  return fopen(sys.c_str(), mode.c_str());
 #endif
 }
 
@@ -50,8 +56,12 @@ FileHandle open_file(const string& filename, const string& mode)
