diff --git a/src/base/system_path.h b/src/base/system_path.h
index 63792feb742b16272e7f82efcb4f657746a79113..a8524e068faf103abcf9fa87ab4073c8b7956fbb 100644
--- a/src/base/system_path.h
+++ b/src/base/system_path.h
@@ -15,12 +15,18 @@ namespace base {
   // where they are passed to or come from the system. Elsewhere these
   // return the name unchanged.
 #ifdef __AROS__
+  // Converts a path for the system. Returns false when the name holds a
+  // character the system character set cannot represent (such a file
+  // cannot exist; the bytes must not reach the file system).
+  bool to_system_path(const std::string& utf8, std::string& out);
+  // The same, but throws std::runtime_error for such a name.
   std::string to_system_path(const std::string& utf8);
   std::string from_system_path(const std::string& name);
   // Text for system widgets (menus, titles): characters the system
   // character set lacks become '?'.
   std::string to_system_text(const std::string& utf8);
 #else
+  inline bool to_system_path(const std::string& utf8, std::string& out) { out = utf8; return true; }
   inline const std::string& to_system_path(const std::string& utf8) { return utf8; }
   inline const std::string& from_system_path(const std::string& name) { return name; }
 #endif
