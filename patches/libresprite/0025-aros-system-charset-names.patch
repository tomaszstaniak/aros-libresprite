@@ -0,0 +1,28 @@
+// Aseprite Base Library
+// Copyright (c) 2026  LibreSprite contributors
+//
+// This file is released under the terms of the MIT license.
+// Read LICENSE.txt for more information.
+
+#pragma once
+
+#include <string>
+
+namespace base {
+
+  // File names inside the program are UTF-8. On AROS the file system and
+  // DOS use the system character set (ENV:CHARSET), so names are converted
+  // where they are passed to or come from the system. Elsewhere these
+  // return the name unchanged.
+#ifdef __AROS__
+  std::string to_system_path(const std::string& utf8);
+  std::string from_system_path(const std::string& name);
+  // Text for system widgets (menus, titles): characters the system
+  // character set lacks become '?'.
+  std::string to_system_text(const std::string& utf8);
+#else
+  inline const std::string& to_system_path(const std::string& utf8) { return utf8; }
+  inline const std::string& from_system_path(const std::string& name) { return name; }
+#endif
+
+} // namespace base
diff --git a/src/base/system_path_aros.cpp b/src/base/system_path_aros.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..47f8e6db921c5dec6a022acc23ed448ebb904dcb
--- /dev/null
+++ b/src/base/system_path_aros.cpp
@@ -0,0 +1,121 @@
+// Aseprite Base Library
+// Copyright (c) 2026  LibreSprite contributors
+//
+// This file is released under the terms of the MIT license.
+// Read LICENSE.txt for more information.
+
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "base/system_path.h"
+
+#include <dos/var.h>
+#include <proto/dos.h>
+
+#include <iconv.h>
+
+#include <cerrno>
+#include <cstring>
+#include <mutex>
+
+namespace base {
+
+namespace {
+
+  // The system character set as named in ENV:CHARSET (codesets.library names,
+  // e.g. "ISO-8859-2"; "ISO-8859-1 + Euro" is read as ISO-8859-1).
+  const std::string& system_charset()
+  {
+    static std::string charset;
+    static std::once_flag once;
+    std::call_once(once, []{
+      char buf[64];
+      if (GetVar("CHARSET", buf, sizeof(buf), GVF_GLOBAL_ONLY) > 0) {
+        charset = buf;
+        auto plus = charset.find('+');
+        if (plus != std::string::npos)
+          charset.erase(plus);
+        while (!charset.empty() && charset.back() == ' ')
+          charset.pop_back();
+      }
+      if (charset.empty())
+        charset = "ISO-8859-1";
+    });
+    return charset;
+  }
+
+  bool is_ascii(const std::string& s)
+  {
+    for (unsigned char c : s)
+      if (c >= 0x80)
+        return false;
+    return true;
+  }
+
+  // Whole-string conversion; false when a character cannot be converted.
+  bool convert(const char* to, const char* from, const std::string& in, std::string& out)
+  {
+    iconv_t cd = iconv_open(to, from);
+    if (cd == (iconv_t)-1)
+      return false;
+    out.assign(in.size() * 4 + 4, '\0');
+    char* src = const_cast<char*>(in.data());
+    size_t srcLeft = in.size();
+    char* dst = &out[0];
+    size_t dstLeft = out.size();
+    size_t r = iconv(cd, &src, &srcLeft, &dst, &dstLeft);
+    iconv_close(cd);
+    if (r == (size_t)-1 || srcLeft != 0)
+      return false;
+    out.resize(out.size() - dstLeft);
+    return true;
+  }
+
+} // anonymous namespace
+
+std::string to_system_path(const std::string& utf8)
+{
+  if (is_ascii(utf8))
+    return utf8;
+  std::string out;
+  // A name the system character set cannot hold cannot exist on disk:
+  // pass it on unchanged and let the call fail.
+  if (convert(system_charset().c_str(), "UTF-8", utf8, out))
+    return out;
+  return utf8;
+}
+
+std::string to_system_text(const std::string& utf8)
+{
+  if (is_ascii(utf8))
+    return utf8;
+  std::string out, piece;
+  for (size_t i = 0; i < utf8.size(); ) {
+    unsigned char c = utf8[i];
+    size_t n = (c < 0x80) ? 1 : ((c & 0xE0) == 0xC0) ? 2 : ((c & 0xF0) == 0xE0) ? 3 : ((c & 0xF8) == 0xF0) ? 4 : 1;
+    if (i + n > utf8.size())
+      n = utf8.size() - i;
+    if (c < 0x80)
+      out += char(c);
+    else if (convert(system_charset().c_str(), "UTF-8", utf8.substr(i, n), piece))
+      out += piece;
+    else
+      out += '?';
+    i += n;
+  }
+  return out;
+}
+
+std::string from_system_path(const std::string& name)
+{
+  if (is_ascii(name))
+    return name;
+  std::string out;
+  if (convert("UTF-8", system_charset().c_str(), name, out) ||
+      convert("UTF-8", "ISO-8859-1", name, out))
+    return out;
+  return name;
+}
+
+} // namespace base
